# Checks for ext/ (the C shim): bugprone, readability and performance, every
# finding an error (`rake clang_tidy`). Any check turned off or narrowed here
# must be listed with its reason in docs/exceptions.md.
Checks: >-
  -*,
  bugprone-*,
  performance-*,
  readability-*
WarningsAsErrors: '*'
HeaderFilterRegex: 'ext/.*'
CheckOptions:
  # Defaults, plus the geometry names: structs cannot cross Spinel's FFI,
  # so (left, top, width, height, size) arrive as separate floats in
  # raylib's order, always unpacked from a Ruby Point or Rect by Screen.
  - key: bugprone-easily-swappable-parameters.IgnoredParameterNames
    value: '"";iterator;Iterator;begin;Begin;end;End;first;First;last;Last;lhs;LHS;rhs;RHS;left;top;width;height;size'
