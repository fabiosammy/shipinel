# Types of the Spinel FFI functions declared in lib/shipinel/ui.rb, which
# Steep cannot read (ffi_func is not Ruby). Mirrors ext/ui_shim.h.
module Shipinel
  module UI
    def self.ui_open_window: (Integer width, Integer height, String title) -> void
    def self.ui_window_ready: () -> bool
    def self.ui_window_should_close: () -> bool
    def self.ui_close_window: () -> void
    def self.ui_window_placeable: () -> bool
    def self.ui_window_x: () -> Integer
    def self.ui_window_y: () -> Integer
    def self.ui_move_window: (Integer left, Integer top) -> void
    def self.ui_show_window: (Integer shown) -> void
    def self.ui_window_shown: () -> bool
    def self.tray_open: (String title) -> bool
    def self.tray_show_progress: (String label, Integer permille) -> void
    def self.tray_next_event: () -> Integer
    def self.tray_close: () -> void
    def self.ui_screen_width: () -> Integer
    def self.ui_screen_height: () -> Integer
    def self.ui_begin_frame: (Integer background_rgba) -> void
    def self.ui_end_frame: () -> void
    def self.ui_skip_frame: () -> bool
    def self.ui_set_extra_codepoints: (Array[Integer] codepoints, Integer count) -> void
    def self.ui_load_font: (Integer slot, String path, Integer pixel_size) -> void
    def self.ui_font_loaded: (Integer slot) -> bool
    def self.ui_glyph_slots: (Integer codepoint) -> Integer
    def self.ui_text_width: (Integer slot, String text, Float size) -> Float
    def self.ui_draw_text: (Integer slot, String text, Float left, Float top, Float size, Integer rgba) -> void
    def self.ui_draw_rect: (Float left, Float top, Float width, Float height, Integer rgba) -> void
    def self.ui_wheel_move: () -> Float
    def self.ui_mouse_x: () -> Integer
    def self.ui_mouse_y: () -> Integer
    def self.ui_mouse_buttons: () -> Integer
    def self.ui_keys_pressed: (Array[Integer] keys, Integer count) -> Integer
    def self.ui_style_checkbox: (Integer border_rgba, Integer hover_rgba, Integer check_rgba) -> void
    def self.ui_draw_checkbox: (Float left, Float top, Float size, bool checked) -> void
    def self.ui_pointer_on: (Float left, Float top, Float width, Float height) -> Integer
    def self.ui_set_hand_cursor: (bool hand) -> void
    def self.ui_control_down: () -> bool
    def self.ui_shift_down: () -> bool
    def self.ui_char_pressed: () -> Integer
    def self.ui_dropped_file: () -> String
    def self.ui_set_clipboard: (String text) -> void
  end
end
